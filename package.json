{
  "name": "portfolio",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:integration": "pnpm --filter @portfolio/infrastructure test:integration && pnpm --filter @portfolio/api test:integration",
    "recovery:rehearse": "bash scripts/recovery/rehearse.sh",
    "release:rehearse": "bash scripts/release/rehearse.sh",
    "bootstrap:first-admin": "bash scripts/deployment/bootstrap-first-admin.sh",
    "supabase:function:bundle": "bash scripts/deployment/build-supabase-function.sh",
    "supabase:function:deploy": "bash scripts/deployment/deploy-supabase-function.sh",
    "web:deployment:check": "node scripts/deployment/check-public-web-deployment.mjs",
    "backup:rehearse": "bash scripts/recovery/test-production-backup.sh",
    "observability:self-test": "node scripts/operations/check-production-observability.mjs --self-test",
    "binary-backup:self-test": "node scripts/recovery/backup-google-drive-binaries.mjs --self-test",
    "binary-backup:restore": "bash scripts/recovery/restore-production-binaries.sh",
    "binary-backup:restore:typecheck": "pnpm --workspace-root exec tsc --noEmit -p scripts/recovery/tsconfig.restore.json",
    "binary-backup:restore:build": "bash scripts/recovery/build-binary-restore-operator.sh .artifacts/binary-restore/restore-production-binaries.mjs"
  },
  "devDependencies": {
    "@types/node": "24.13.5",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  }
}
