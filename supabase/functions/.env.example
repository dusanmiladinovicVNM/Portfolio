# Supabase supplies SUPABASE_DB_URL in hosted Edge Functions.
PORTFOLIO_WEB_ORIGIN=https://portfolio.example.com

PORTFOLIO_GOOGLE_DRIVE_FOLDER_ID=replace-with-folder-id
PORTFOLIO_GOOGLE_CLIENT_ID=replace-with-oauth-client-id
PORTFOLIO_GOOGLE_CLIENT_SECRET=replace-with-oauth-client-secret
PORTFOLIO_GOOGLE_REFRESH_TOKEN=replace-with-oauth-refresh-token

# Optional; defaults to 1000 ms.
PORTFOLIO_READINESS_TIMEOUT_MS=1000
